# 应用
APP_ENV=local
LOG_LEVEL=INFO
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000

# Qwen：聊天走 OpenAI 兼容端点；qwen3-vl-embedding 走 DashScope 原生多模态 Embedding SDK（不支持 OpenAI Embeddings 接口）
QWEN_API_KEY=replace-me
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen3.8-flash
QWEN_EMBEDDING_MODEL=qwen3-vl-embedding
QWEN_EMBEDDING_DIM=1024
QWEN_REQUEST_TIMEOUT_SECONDS=25
QWEN_MAX_RETRIES=2
MODEL_MAX_CONCURRENCY=4

# Milvus
MILVUS_URI=http://192.168.100.128:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=luoyang_tourism_knowledge_v1
MILVUS_METRIC_TYPE=COSINE

# Redis / LangGraph checkpoint（服务器必须为 Redis 8.x + RedisJSON/RediSearch；PING 不代表性）
REDIS_URL=redis://192.168.100.128:6379/0
CHECKPOINT_KEY_PREFIX=langgraph:checkpoint:
CHECKPOINT_TTL_SECONDS=604800

# Spring Boot internal service
SPRINGBOOT_INTERNAL_BASE_URL=http://127.0.0.1:8080
INTERNAL_SHARED_SECRET=replace-with-long-random-secret
INTERNAL_TIMESTAMP_TOLERANCE_SECONDS=300

# RAG / Agent budget
RAG_TOP_K=5
RAG_MIN_SCORE=0
RAG_MAX_CONTEXT_CHARS=8000
AGENT_MAX_TOOL_CALLS=6
AGENT_RECURSION_LIMIT=12
TOOL_TIMEOUT_SECONDS=10
CHAT_TOTAL_TIMEOUT_SECONDS=28

# Indexing
INDEX_MAX_CHUNKS=2000
EMBEDDING_BATCH_SIZE=16



# Runtime hardening
LOG_MAX_FIELD_CHARS=2000
MILVUS_SEARCH_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=3
CHECKPOINT_SETUP_TIMEOUT_SECONDS=10
CHAT_RESULT_CACHE_TTL_SECONDS=600
CHAT_INFLIGHT_TTL_SECONDS=60
INDEX_JOB_TTL_SECONDS=604800
AGENT_MAX_HISTORY_MESSAGES=12
INDEX_CALLBACK_BATCH_SIZE=50
DOWNLOAD_MAX_BYTES=52428800

CHECKPOINTER_BACKEND=redis

