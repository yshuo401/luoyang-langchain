# 应用
APP_ENV=local
LOG_LEVEL=INFO
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000

# Qwen：聊天走 OpenAI 兼容端点；Embedding 使用 DashScopeEmbeddings
QWEN_API_KEY=replace-me
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen3.8-flash
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_REQUEST_TIMEOUT_SECONDS=25
QWEN_MAX_RETRIES=2

# MinerU：TXT/Markdown 不需要；PDF/DOCX/图片需要
MINERU_API_KEY=replace-me
MINERU_BASE_URL=
MINERU_MODEL=
MINERU_TIMEOUT_SECONDS=300
MINERU_BYPASS_PROXY=true

# Milvus。更换 Embedding 模型后必须使用新的 collection 并重新索引。
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=luoyang_tourism_knowledge_v2
MILVUS_METRIC_TYPE=COSINE
MILVUS_SEARCH_TIMEOUT_SECONDS=8

# Spring Boot 内部接口
SPRINGBOOT_INTERNAL_BASE_URL=http://127.0.0.1:8080
INTERNAL_TOKEN=change-me-local-internal-token

# RAG / Agent
RAG_TOP_K=5
AGENT_MAX_TOOL_CALLS=6
AGENT_RECURSION_LIMIT=12
TOOL_TIMEOUT_SECONDS=20
CHAT_TOTAL_TIMEOUT_SECONDS=28
MCP_12306_ENABLED=false
MCP_TOOL_TIMEOUT_SECONDS=30

# 索引
INDEX_MAX_CHUNKS=2000
INDEX_CALLBACK_BATCH_SIZE=50
DOWNLOAD_MAX_BYTES=52428800
